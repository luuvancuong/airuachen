# Chép file này thành .env rồi điền giá trị. .env không được commit (đã có trong .gitignore).
# Biến đã đặt sẵn trong môi trường sẽ không bị .env ghi đè.

# Cổng và địa chỉ nghe (mặc định 3000, 127.0.0.1). Chạy trên VPS thì HOST=0.0.0.0 và nhớ đặt ADMIN_TOKEN.
# PORT=3000
# HOST=127.0.0.1
# ADMIN_TOKEN=
# TIKTOK_USERNAME=
# EULER_API_KEY=

# Giọng đọc Vbee: tạo app ở https://studio.vbee.vn/apps → "Tích hợp API" → "Tạo ứng dụng".
# Thiếu hai khoá này thì giọng đọc dùng speechSynthesis của trình duyệt.
VBEE_APP_ID=
VBEE_TOKEN=
# Mã giọng, mặc định Minh Quân (kiểu YouTuber). Có thể đổi trong Luật chơi (ô Mã giọng).
# Gợi ý khác: hn_male_vietbach_child_22k-vc (bé trai), hn_female_nganha_child_22k-vc (bé gái), sg_female_tuongvy_call_44k-fhg (SG, tươi)
# VBEE_VOICE=hn_male_minhquan_yt-stable
# Tốc độ đọc 0.25–1.9 (mặc định 1.1)
# VBEE_SPEED=1
# auto (thử sync, lỗi thì async; gói không có sync thì tự ghi nhớ ở data/tts/.no-sync) | sync | async
# VBEE_MODE=auto
# Async bắt buộc có webhookUrl nhưng server tự hỏi lại kết quả, không cần nhận callback.
# VBEE_WEBHOOK=https://example.com/vbee-callback
